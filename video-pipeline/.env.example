# Copy to .env and fill in only the keys for the providers you use ([providers] in series.toml).
# avp reads .env from the current folder automatically; real environment variables win. Local models need none.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=          # Alibaba Model Studio (百炼): CosyVoice, Qwen-Image, Wan
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Optional: path to a Chromium/Chrome binary for diagram rendering
# AVP_CHROMIUM=
